  "materialRules": {
    "damage": {
      "formula": "base * strengthMultiplier",
      "description": "Damage scales with material strength"
    },
    "weight": {
      "formula": "base * weightMultiplier",
      "description": "Weight scales with material density"
    },
    "durability": {
      "formula": "base * (durability / 100)",
      "description": "Durability is material-specific"
    },
    "value": {
      "formula": "base * value",
      "description": "Value multiplier affects object worth"
    },
    "stackingRules": {
      "multipleMetals": "last_wins",
      "description": "Only one metal material can apply"
    }
  }
