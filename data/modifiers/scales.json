  "scalingRules": {
    "damage": {
      "formula": "base * (strengthMultiplier * 0.8 + multiplier * 0.2)",
      "description": "Damage scales with both strength and size"
    },
    "defense": {
      "formula": "base * multiplier",
      "description": "Defense scales linearly with size"
    },
    "speed": {
      "formula": "base * speedMultiplier",
      "description": "Speed inversely scales with size"
    },
    "weight": {
      "formula": "base * weightMultiplier",
      "description": "Weight scales with cube of size"
    },
    "health": {
      "formula": "base * (multiplier * 0.7 + 1)",
      "description": "Health scales moderately with size"
    },
    "canBeHeld": {
      "maxMultiplier": 5.0,
      "description": "Objects larger than 5x cannot be held"
    },
    "isHeavy": {
      "minMultiplier": 2.0,
      "description": "Objects 2x or larger are considered heavy"
    }
