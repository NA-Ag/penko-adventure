    "OPEN": {
      "priority": 75,
      "specificity": "high",
      "description": "Open a specific object - requires target",
      "requires_target": true,
      "examples": ["open door", "unlock chest", "unfasten gate"]
    },
    "CLOSE": {
      "priority": 75,
      "specificity": "high",
      "description": "Close a specific object - requires target",
      "requires_target": true,
      "examples": ["close door", "shut window", "seal container"]
