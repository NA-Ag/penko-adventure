    "DROP": {
      "priority": 75,
      "specificity": "high",
      "description": "Drop a specific object - requires target",
      "requires_target": true,
      "examples": ["drop sword", "put down map", "leave key"]
    },
    "BURN": {
      "priority": 75,
      "specificity": "high",
      "description": "Burn a specific object - requires target",
      "requires_target": true,
      "examples": ["burn paper", "ignite torch", "set fire to"]
