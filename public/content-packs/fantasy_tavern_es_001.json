      {
        "id": "tavern_main",
        "name": "Sala Principal",
        "biome": "interior",
        "timeOfDay": "day",
        "description": "Una acogedora taberna con mesas de madera y una chimenea crepitante. El olor a pan recién horneado llena el aire.",
        "features": ["fireplace", "bar_counter", "wooden_tables"],
        "entities": ["bartender", "merchant"],
        "items": ["menu", "gold_coin"],
        "connections": {
          "north": "tavern_kitchen",
          "east": "tavern_rooms"
        },
        "metadata": {
          "visited": false,
          "discoverable": true
        }
      },
      {
        "id": "tavern_kitchen",
        "name": "Cocina",
        "biome": "interior",
        "timeOfDay": "day",
        "description": "Una cocina bulliciosa donde el cocinero prepara deliciosas comidas. Ollas y sartenes cuelgan de las paredes.",
        "features": ["stove", "cooking_pot"],
        "entities": ["cook"],
        "items": ["bread", "cheese"],
        "connections": {
          "south": "tavern_main"
        },
        "metadata": {
          "visited": false,
          "discoverable": true
        }
      },
      {
        "id": "tavern_rooms",
        "name": "Habitaciones",
        "biome": "interior",
        "timeOfDay": "day",
        "description": "Un pasillo tranquilo con varias puertas de madera que conducen a habitaciones privadas.",
        "features": ["beds", "windows"],
        "entities": [],
        "items": ["key"],
        "connections": {
          "west": "tavern_main"
        },
        "metadata": {
          "visited": false,
          "discoverable": true
        }
      }
    ],
    "entities": [
      {
        "id": "bartender",
        "name": "Tabernero",
        "type": "HUMANOID",
        "behavior": "FRIENDLY",
        "description": "Un hombre alegre con un delantal blanco y una sonrisa cálida.",
        "dialogue": [
          {
            "id": "greeting",
            "condition": "first_meeting",
            "text": "¡Bienvenido a La Taberna del Dragón! ¿Qué deseas beber?",
            "responses": [
              {
                "text": "Una cerveza, por favor",
                "effect": "order_beer"
              },
              {
                "text": "Solo agua",
                "effect": "order_water"
              },
              {
                "text": "¿Tienes comida?",
                "effect": "ask_food"
              }
            ]
          }
        ],
        "quests": ["find_lost_recipe"],
        "shop": {
          "currency": "gold",
          "items": [
            {
              "itemId": "beer",
              "price": 5,
              "stock": null
            },
            {
              "itemId": "bread",
              "price": 2,
              "stock": 10
            }
          ]
        }
      },
      {
        "id": "merchant",
        "name": "Mercader",
        "type": "HUMANOID",
        "behavior": "FRIENDLY",
        "description": "Un mercader viajero con una mochila grande y ropa gastada por el camino.",
        "dialogue": [
          {
            "id": "greeting",
            "condition": "first_meeting",
            "text": "Saludos, viajero. ¿Buscas algo especial? Tengo mercancías de todas partes del reino.",
            "responses": [
              {
                "text": "¿Qué vendes?",
                "effect": "show_shop"
              },
              {
                "text": "Cuéntame sobre tus viajes",
                "effect": "tell_stories"
              }
            ]
          }
        ],
        "quests": [],
        "shop": {
          "currency": "gold",
          "items": [
            {
              "itemId": "health_potion",
              "price": 20,
              "stock": 5
            }
          ]
        }
      },
      {
        "id": "cook",
        "name": "Cocinero",
        "type": "HUMANOID",
        "behavior": "FRIENDLY",
        "description": "Un cocinero hábil con un gorro blanco y manos expertas.",
        "dialogue": [
          {
            "id": "greeting",
            "condition": "first_meeting",
            "text": "¡Ah! ¿Tienes hambre? Estoy preparando mi estofado especial.",
            "responses": [
              {
                "text": "¿Puedo ayudarte?",
                "effect": "offer_help"
              },
              {
                "text": "Huele delicioso",
                "effect": "compliment"
              }
            ]
          }
        ],
        "quests": ["find_lost_recipe"],
        "shop": null
      }
    ],
