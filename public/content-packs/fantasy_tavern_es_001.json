    "description": "A cozy fantasy tavern for beginner Spanish learners. Practice basic conversation and vocabulary in a welcoming environment.",
    "author": "penko_team",
    "version": "1.0.0",
    "created": "2025-12-09",
    "language": "SPANISH",
    "genre": "fantasy",
