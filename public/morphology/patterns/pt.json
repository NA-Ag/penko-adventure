        "present_1s": "estou",
        "present_2s": "estás",
        "present_3s": "está",
        "present_1p": "estamos",
        "present_2p": "estais",
        "present_3p": "estão"
      }
    },
    {
      "infinitive": "ter",
      "pattern": "irregular",
      "irregular": {
        "infinitive": "ter",
        "present_1s": "tenho",
        "present_2s": "tens",
        "present_3s": "tem",
