        "present_2p": "fazeis",
        "present_3p": "fazem"
      }
    }
  ],
  "nouns": [
    {"singular": "livro", "pattern": "regular_o"},
    {"singular": "menino", "pattern": "regular_o"},
    {"singular": "casa", "pattern": "regular_a"},
    {"singular": "menina", "pattern": "regular_a"},
    {"singular": "cidade", "pattern": "regular_vowel"},
