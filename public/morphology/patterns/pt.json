    {"infinitive": "aprender", "pattern": "regular_er"},
    {"infinitive": "partir", "pattern": "regular_ir"},
    {"infinitive": "abrir", "pattern": "regular_ir"},
    {"infinitive": "decidir", "pattern": "regular_ir"},
    {
      "infinitive": "ser",
      "pattern": "irregular",
      "irregular": {
        "infinitive": "ser",
        "present_1s": "sou",
        "present_2s": "és",
        "present_3s": "é",
        "present_1p": "somos",
        "present_2p": "sois",
        "present_3p": "são",
        "preterite_1s": "fui",
