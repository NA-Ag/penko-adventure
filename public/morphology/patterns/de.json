{
  "verbPatterns": [
    {
      "name": "weak_regular",
      "description": "Regular weak verbs (machen, spielen, arbeiten, etc.) - Most German verbs",
      "getStem": "infinitive.slice(0, -2)",
      "rules": {
        "infinitive": "base",
        "past_participle": "'ge' + stem + 't'",
        "present_1s": "stem + 'e'",
        "present_2s": "stem + 'st'",
        "present_3s": "stem + 't'",
        "present_1p": "stem + 'en'",
        "present_2p": "stem + 't'",
        "present_3p": "stem + 'en'",
        "preterite_1s": "stem + 'te'",
        "preterite_2s": "stem + 'test'",
        "preterite_3s": "stem + 'te'",
        "preterite_1p": "stem + 'ten'",
        "preterite_2p": "stem + 'tet'",
        "preterite_3p": "stem + 'ten'",
        "subjunctive_ii_1s": "stem + 'te'",
        "subjunctive_ii_2s": "stem + 'test'",
        "subjunctive_ii_3s": "stem + 'te'",
        "subjunctive_ii_1p": "stem + 'ten'",
        "subjunctive_ii_2p": "stem + 'tet'",
        "subjunctive_ii_3p": "stem + 'ten'"
      }
    },
    {
      "name": "weak_d_t_stem",
      "description": "Weak verbs with stem ending in -d or -t (arbeiten, reden, etc.)",
      "getStem": "infinitive.slice(0, -2)",
      "rules": {
        "infinitive": "base",
        "past_participle": "'ge' + stem + 'et'",
        "present_1s": "stem + 'e'",
        "present_2s": "stem + 'est'",
        "present_3s": "stem + 'et'",
        "present_1p": "stem + 'en'",
        "present_2p": "stem + 'et'",
        "present_3p": "stem + 'en'",
        "preterite_1s": "stem + 'ete'",
        "preterite_2s": "stem + 'etest'",
        "preterite_3s": "stem + 'ete'",
        "preterite_1p": "stem + 'eten'",
        "preterite_2p": "stem + 'etet'",
        "preterite_3p": "stem + 'eten'"
      }
    }
  ],
  "nounPatterns": [
    {
      "name": "masculine_regular",
      "description": "Regular masculine nouns (add -(e)s in genitive, -e in plural)",
      "gender": "m",
      "rules": {
        "nominative_singular": "base",
        "nominative_plural": "base + 'e'",
        "accusative_singular": "base",
        "accusative_plural": "base + 'e'",
        "dative_singular": "base",
        "dative_plural": "base + 'en'",
        "genitive_singular": "base + 's'",
        "genitive_plural": "base + 'e'"
      }
    },
    {
      "name": "feminine_regular",
      "description": "Regular feminine nouns (add -n or -en in plural)",
      "gender": "f",
      "rules": {
        "nominative_singular": "base",
        "nominative_plural": "base + 'n'",
        "accusative_singular": "base",
        "accusative_plural": "base + 'n'",
        "dative_singular": "base",
        "dative_plural": "base + 'n'",
        "genitive_singular": "base",
        "genitive_plural": "base + 'n'"
      }
    },
    {
      "name": "feminine_en",
      "description": "Feminine nouns ending in -e (add -n in plural)",
      "gender": "f",
      "rules": {
        "nominative_singular": "base",
        "nominative_plural": "base + 'n'",
        "accusative_singular": "base",
        "accusative_plural": "base + 'n'",
        "dative_singular": "base",
        "dative_plural": "base + 'n'",
        "genitive_singular": "base",
        "genitive_plural": "base + 'n'"
      }
    },
    {
      "name": "neuter_regular",
      "description": "Regular neuter nouns (no change or -e in plural)",
      "gender": "n",
      "rules": {
        "nominative_singular": "base",
        "nominative_plural": "base + 'e'",
        "accusative_singular": "base",
        "accusative_plural": "base + 'e'",
        "dative_singular": "base",
        "dative_plural": "base + 'en'",
        "genitive_singular": "base + 's'",
        "genitive_plural": "base + 'e'"
      }
    },
    {
      "name": "noun_er_plural",
      "description": "Nouns with -er plural (Mann→Männer, Kind→Kinder)",
      "rules": {
        "nominative_singular": "base",
        "nominative_plural": "base + 'er'",
        "accusative_singular": "base",
        "accusative_plural": "base + 'er'",
        "dative_singular": "base",
        "dative_plural": "base + 'ern'",
        "genitive_singular": "base + 'es'",
        "genitive_plural": "base + 'er'"
      }
    },
    {
      "name": "noun_s_plural",
      "description": "Nouns with -s plural (foreign words: Auto→Autos)",
      "rules": {
        "nominative_singular": "base",
        "nominative_plural": "base + 's'",
        "accusative_singular": "base",
        "accusative_plural": "base + 's'",
        "dative_singular": "base",
        "dative_plural": "base + 's'",
        "genitive_singular": "base + 's'",
        "genitive_plural": "base + 's'"
      }
    }
  ],
  "adjectivePatterns": [
    {
      "name": "regular",
      "description": "Regular adjectives (comparison: -er, -st)",
      "rules": {
        "positive": "base",
        "comparative": "base + 'er'",
        "superlative": "base + 'st'"
      }
    },
    {
      "name": "umlaut_comparative",
      "description": "Adjectives with umlaut in comparative (alt→älter)",
      "rules": {
        "positive": "base",
        "comparative": "base.replace('a', 'ä').replace('o', 'ö').replace('u', 'ü') + 'er'",
        "superlative": "base.replace('a', 'ä').replace('o', 'ö').replace('u', 'ü') + 'st'"
      }
    }
  ],
