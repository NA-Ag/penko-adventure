  "adjectivePatterns": [
    {
      "name": "regular_e",
      "description": "Adjectives ending in -e (invariable for gender)",
      "rules": {
        "masculine_singular": "base",
        "feminine_singular": "base",
        "masculine_plural": "base + 's'",
        "feminine_plural": "base + 's'"
      }
    },
    {
      "name": "regular_consonant",
      "description": "Adjectives ending in consonant (add -e for feminine)",
      "rules": {
        "masculine_singular": "base",
        "feminine_singular": "base + 'e'",
        "masculine_plural": "base + 's'",
        "feminine_plural": "base + 'es'"
      }
    },
    {
      "name": "regular_s",
      "description": "Adjectives ending in -s (add -e for feminine, no change for masc plural)",
      "rules": {
        "masculine_singular": "base",
        "feminine_singular": "base + 'e'",
        "masculine_plural": "base",
        "feminine_plural": "base + 'es'"
      }
    },
    {
      "name": "adjective_f",
      "description": "Adjectives ending in -f (feminine -ve)",
      "rules": {
        "masculine_singular": "base",
        "feminine_singular": "base.slice(0, -1) + 've'",
        "masculine_plural": "base + 's'",
        "feminine_plural": "base.slice(0, -1) + 'ves'"
      }
    },
    {
      "name": "adjective_x",
      "description": "Adjectives ending in -x (feminine -se)",
      "rules": {
        "masculine_singular": "base",
        "feminine_singular": "base.slice(0, -1) + 'se'",
        "masculine_plural": "base",
        "feminine_plural": "base.slice(0, -1) + 'ses'"
      }
    }
