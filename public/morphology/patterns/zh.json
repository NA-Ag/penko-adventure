{
  "verbPatterns": [
    {
      "name": "regular_verb",
      "description": "Regular verbs (Chinese verbs don't conjugate)",
      "rules": {
        "base": "base",
        "progressive": "base + ' + 着'",
        "perfective": "base + ' + 了'",
        "experiential": "base + ' + 过'",
        "negative": "'不' + base",
        "negative_past": "'没' + base",
        "potential_can": "'能' + base",
        "potential_know_how": "'会' + base"
      }
    }
  ],
  "nounPatterns": [
    {
      "name": "regular_noun",
      "description": "Regular nouns (Chinese nouns don't decline)",
      "rules": {
        "singular": "base",
        "plural": "base + '们'",
        "with_measure_generic": "'一个' + base",
        "with_measure_flat": "'一张' + base",
        "with_measure_long": "'一条' + base",
        "with_measure_book": "'一本' + base",
        "with_measure_small_round": "'一颗' + base"
      }
    },
    {
      "name": "person_noun",
      "description": "Person nouns (use 们 for plural)",
      "rules": {
        "singular": "base",
        "plural": "base + '们'",
        "with_measure": "'一位' + base"
      }
    }
  ],
  "adjectivePatterns": [
    {
      "name": "regular_adjective",
      "description": "Regular adjectives (Chinese adjectives don't conjugate)",
      "rules": {
        "base": "base",
        "very": "'很' + base",
        "comparative": "'比较' + base",
        "superlative": "'最' + base",
        "too": "'太' + base"
      }
    }
  ],
