{
  "verbPatterns": [
    {
      "name": "first_conjugation_ать",
      "description": "First conjugation verbs ending in -ать (делать, читать, etc.) - Most Russian verbs",
      "getStem": "infinitive.slice(0, -2)",
      "rules": {
        "infinitive": "base",
        "present_1s": "stem + 'ю'",
        "present_2s": "stem + 'ешь'",
        "present_3s": "stem + 'ет'",
        "present_1p": "stem + 'ем'",
        "present_2p": "stem + 'ете'",
        "present_3p": "stem + 'ют'",
        "past_m": "stem + 'л'",
        "past_f": "stem + 'ла'",
        "past_n": "stem + 'ло'",
        "past_pl": "stem + 'ли'"
      }
    },
    {
      "name": "first_conjugation_ять",
      "description": "First conjugation verbs ending in -ять (гулять, etc.)",
      "getStem": "infinitive.slice(0, -2)",
