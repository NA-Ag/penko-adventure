        "past_n": "stem + 'ло'",
        "past_pl": "stem + 'ли'"
      }
    },
    {
      "name": "second_conjugation_ить",
      "description": "Second conjugation verbs ending in -ить (говорить, любить, etc.)",
      "getStem": "infinitive.slice(0, -3)",
      "rules": {
        "infinitive": "base",
        "present_1s": "stem + 'ю'",
        "present_2s": "stem + 'ишь'",
        "present_3s": "stem + 'ит'",
        "present_1p": "stem + 'им'",
        "present_2p": "stem + 'ите'",
        "present_3p": "stem + 'ят'",
        "past_m": "stem + 'ил'",
        "past_f": "stem + 'ила'",
        "past_n": "stem + 'ило'",
        "past_pl": "stem + 'или'"
      }
    },
    {
      "name": "first_conjugation_овать",
      "description": "Verbs ending in -овать (работать, рисовать, etc.)",
      "getStem": "infinitive.slice(0, -5)",
